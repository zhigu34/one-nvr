# syntax=docker/dockerfile:1
ARG GO_IMAGE=golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195
ARG NODE_IMAGE=node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
ARG NGINX_IMAGE=nginx:1.30.5-alpine3.24@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
FROM ${GO_IMAGE} AS control-build
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY} CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations
COPY deploy/production/templates ./deploy/production/templates
RUN go build -trimpath -buildvcs=false -o /gateway-control ./cmd/gateway-control
FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY=https://registry.npmjs.org
ENV npm_config_registry=${NPM_REGISTRY}
RUN npm install --global --ignore-scripts --no-audit --no-fund pnpm@10.12.4
WORKDIR /src
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web/ ./
RUN pnpm build
FROM ${NGINX_IMAGE}
COPY --from=control-build /gateway-control /usr/local/bin/gateway-control
COPY deploy/production/gateway-entrypoint.sh /usr/local/bin/gateway-entrypoint
COPY --from=build /src/dist/ /usr/share/nginx/html/
# Bind-mounted source modes must not repeat the M0 nginx permission failure.
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} \; && \
    find /usr/share/nginx/html -type f -exec chmod 644 {} \;

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/gateway-entrypoint"]
