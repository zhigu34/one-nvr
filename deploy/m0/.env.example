# Server IP reachable by the browser; not a camera/container IP.
M0_MEDIA_HOST=192.168.1.10
# Choose exactly one: cpu (EPYC software decode + CPU inference), intel (N5105 VAAPI + GPU).
COMPOSE_PROFILES=cpu

# Host paths shared by init and running services.
M0_STATE_DIR=./state
M0_STORAGE_ROOT=./storage
M0_HTTPS_PORT=8443
M0_RTC_PORT=8000
M0_SHM_SIZE=256mb
# Only used when COMPOSE_PROFILES=intel; confirm the actual host render device.
M0_GPU_DEVICE=/dev/dri/renderD128

# Full URLs: camera1 -> CH01, camera2 -> CH02, ... camera32 -> CH32.
# Use ASCII single quotes to preserve $ and # literally. URL-encode reserved characters in credentials.
camera1='rtsp://admin:your-password@192.168.1.101:554/main'
camera1_sub='rtsp://admin:your-password@192.168.1.101:554/sub'
camera1_name='入口'
camera2='rtsp://admin:your-password@192.168.1.102:554/main'
camera2_sub='rtsp://admin:your-password@192.168.1.102:554/sub'
camera2_name='走廊'
