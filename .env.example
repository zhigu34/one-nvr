# Literal values only. Never sourced as shell; do not add secrets here.
ONE_NVR_PUBLIC_URL=https://192.168.1.10:8443
ONE_NVR_HTTP_PORT=8080
ONE_NVR_HTTPS_PORT=8443
ONE_NVR_RTC_PORT=8000
# 站点时区（IANA 名称）。所有容器统一使用它，日志时间可与界面直接对照。
ONE_NVR_TZ=Asia/Shanghai
# 可选：暴露检测服务（Frigate）自带的 Web 界面，用于排查；留空或 0 表示不暴露。
ONE_NVR_FRIGATE_UI_PORT=
# Omit for an IP URL. Domain URL requires the reachable media IP.
ONE_NVR_MEDIA_HOST=
# Host application data directory, e.g. /vol1/1000/docker/one-nvr/data on NAS.
# First deploy creates it and generates keys, database and runtime config inside.
# Choose a dedicated empty directory; do not use the repository or recordings root.
# No manual key/password files needed. Keep this directory across updates.
ONE_NVR_DATA_DIR=/srv/one-nvr
# Existing root containing mounted pool directories. No bottom-layer storage management.
ONE_NVR_STORAGE_ROOT=/srv/one-nvr-storage
# Explicit allowed camera IP ranges. Empty permits setup but rejects source configuration.
ONE_NVR_CAMERA_CIDRS=192.168.1.0/24
# Optional: private callback network. Change only if it overlaps a local/Docker network.
# Use an aligned private IPv4 /29, separate from camera ranges.
# ONE_NVR_HOOK_SUBNET=172.30.254.0/29
# Existing directory containing fullchain.pem and privkey.pem. Empty = manual/self-signed.
ONE_NVR_TLS_DIR=
ONE_NVR_FRIGATE_ENABLE=no
ONE_NVR_OPENLIST_ENABLE=no
# 可选：发布自带 OpenList 的配置页到宿主机（首次创建管理员账号就在那里）。
# 仅在 ONE_NVR_OPENLIST_ENABLE=yes 时有效；留空或 0 表示不发布。
ONE_NVR_OPENLIST_UI_PORT=
ONE_NVR_HARDWARE_PROFILE=auto
# Optional upstream overrides must include @sha256:<64 hex>.
# ONE_NVR_ZLM_IMAGE=registry.example/zlm:tested@sha256:...

# Build only: one HTTPS Go proxy, optionally followed by ,direct.
# Empty/omitted uses the same default. Values are literal, not shell commands.
ONE_NVR_GOPROXY=https://goproxy.cn,direct
# Build-only forward proxy: HTTP or mixed port reachable from Docker containers.
# Example: http://192.168.1.2:7890 (no credentials). Empty = disabled.
ONE_NVR_HTTP_PROXY=
# Empty = reuse HTTP_PROXY for HTTPS downloads; the URL can still start with http://.
ONE_NVR_HTTPS_PROXY=
# Add internal package-source hosts here to connect directly.
ONE_NVR_NO_PROXY=localhost,127.0.0.1,::1
